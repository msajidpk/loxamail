model Notification {
  id                String  @id @default(uuid()) @db.VarChar(36)
  customerAccountId String? @db.VarChar(36)
  eventType         String  @db.VarChar(100)
  title             String? @db.VarChar(191)
  body              String? @db.Text

  customerAccount CustomerAccount?       @relation(fields: [customerAccountId], references: [id], onDelete: Restrict)
  deliveries      NotificationDelivery[]
  contexts        NotificationContext[]

  createdAt DateTime @default(now()) @db.DateTime(3)

  @@index([customerAccountId, createdAt])
}

model NotificationDelivery {
  id                   String    @id @default(uuid()) @db.VarChar(36)
  notificationId       String    @db.VarChar(36)
  recipientUserId      String    @db.VarChar(36)
  customerMembershipId String?   @db.VarChar(36)
  customerAccountId    String?   @db.VarChar(36)
  channel              String    @db.VarChar(50)
  templateId           String?   @db.VarChar(36)
  status               String    @db.VarChar(50)
  sentAt               DateTime? @db.DateTime(3)
  failureInformation   String?   @db.Text

  notification Notification          @relation(fields: [notificationId], references: [id], onDelete: Restrict)
  recipient    User                  @relation(fields: [recipientUserId], references: [id], onDelete: Restrict)
  membership   CustomerMembership?   @relation(fields: [customerMembershipId, recipientUserId, customerAccountId], references: [id, userId, customerAccountId], onDelete: Restrict)
  template     NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.DateTime(3)

  @@unique([notificationId, recipientUserId, channel])
  @@index([notificationId])
  @@index([recipientUserId])
  @@index([customerMembershipId, recipientUserId, customerAccountId])
  @@index([templateId])
  @@index([status])
}

