generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum CustomerAccountType {
  COMPANY
  INDIVIDUAL
}

enum RoleScope {
  CUSTOMER
  INTERNAL
}

enum ProvisioningCategory {
  EXTERNAL_PROVIDER
  INTERNAL_MANUAL
  HYBRID
  FUTURE_INTEGRATION
}

enum DocumentVisibility {
  CUSTOMER
  INTERNAL
  RESTRICTED
}

enum TicketMessageVisibility {
  PUBLIC
  INTERNAL
  SYSTEM
}

enum AuditActorType {
  USER
  SYSTEM
}

model CustomerAccount {
  id          String              @id @default(uuid()) @db.VarChar(36)
  type        CustomerAccountType
  displayName String              @db.VarChar(191)
  status      String              @db.VarChar(50)

  contacts             Contact[]
  memberships          CustomerMembership[]
  leads                Lead[]
  opportunities        Opportunity[]
  activities           ActivityContext[]     @relation("ActivityContextCustomerAccount")
  quotes               Quote[]
  orders               Order[]
  services             Service[]
  invoices             Invoice[]
  payments             Payment[]
  credits              Credit[]
  tickets              Ticket[]
  documents            Document[]
  documentRelations    DocumentRelation[]    @relation("DocumentRelationCustomerAccount")
  notifications        Notification[]
  notificationContexts NotificationContext[] @relation("NotificationContextCustomerAccount")

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
}

model Contact {
  id                String  @id @default(uuid()) @db.VarChar(36)
  customerAccountId String  @db.VarChar(36)
  userId            String? @db.VarChar(36)
  displayName       String  @db.VarChar(191)
  email             String? @db.VarChar(191)

  customerAccount   CustomerAccount    @relation(fields: [customerAccountId], references: [id], onDelete: Restrict)
  user              User?              @relation("ContactUser", fields: [userId], references: [id], onDelete: SetNull)
  leads             Lead[]             @relation("LeadContact")
  opportunities     Opportunity[]      @relation("OpportunityContact")
  quotes            Quote[]            @relation("QuoteContact")
  invoiceContacts   Invoice[]          @relation("InvoiceBillingContact")
  tickets           Ticket[]           @relation("TicketContact")
  ticketMessages    TicketMessage[]    @relation("TicketMessageContactAuthor")
  activities        ActivityContext[]  @relation("ActivityContextContact")
  documentRelations DocumentRelation[] @relation("DocumentRelationContact")

  createdAt DateTime @default(now()) @db.DateTime(3)

  @@index([customerAccountId])
  @@index([userId])
}

model User {
  id String @id @default(uuid()) @db.VarChar(36)

  contacts                 Contact[]                @relation("ContactUser")
  memberships              CustomerMembership[]
  internalRoleAssignments  InternalRoleAssignment[]
  assignedActivities       Activity[]               @relation("ActivityAssignee")
  ownedLeads               Lead[]                   @relation("LeadOwner")
  ownedOpportunities       Opportunity[]            @relation("OpportunityOwner")
  openedTickets            Ticket[]                 @relation("TicketOpenedBy")
  assignedTickets          Ticket[]                 @relation("TicketAssignee")
  ticketMessages           TicketMessage[]          @relation("TicketMessageAuthor")
  notificationDeliveries   NotificationDelivery[]
  notificationPreferences  NotificationPreference[] @relation("UserNotificationPreferences")
  uploadedDocuments        Document[]               @relation("DocumentUploader")
  uploadedDocumentVersions DocumentVersion[]        @relation("DocumentVersionUploader")
  documentRelations        DocumentRelation[]       @relation("DocumentRelationUser")
  notificationContexts     NotificationContext[]    @relation("NotificationContextUser")
  auditEvents              AuditEvent[]             @relation("AuditActor")

  createdAt DateTime @default(now()) @db.DateTime(3)
}

model CustomerMembership {
  id                String  @id @default(uuid()) @db.VarChar(36)
  userId            String  @db.VarChar(36)
  customerAccountId String  @db.VarChar(36)
  roleId            String? @db.VarChar(36)
  status            String  @db.VarChar(50)

  user                    User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  customerAccount         CustomerAccount          @relation(fields: [customerAccountId], references: [id], onDelete: Restrict)
  role                    Role?                    @relation("MembershipRole", fields: [roleId], references: [id], onDelete: SetNull)
  notificationDeliveries  NotificationDelivery[]
  notificationPreferences NotificationPreference[] @relation("MembershipNotificationPreferences")

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  @@unique([userId, customerAccountId])
  @@unique([id, userId])
  @@unique([id, userId, customerAccountId])
  @@index([customerAccountId])
  @@index([roleId])
}

model Role {
  id    String    @id @default(uuid()) @db.VarChar(36)
  key   String    @db.VarChar(100)
  scope RoleScope
  name  String    @db.VarChar(191)

  memberships         CustomerMembership[]     @relation("MembershipRole")
  internalAssignments InternalRoleAssignment[]
}

model InternalRoleAssignment {
  id     String @id @default(uuid()) @db.VarChar(36)
  userId String @db.VarChar(36)
  roleId String @db.VarChar(36)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([roleId])
}

model Lead {
  id                String  @id @default(uuid()) @db.VarChar(36)
  title             String  @db.VarChar(191)
  status            String  @db.VarChar(50)
  customerAccountId String? @db.VarChar(36)
  contactId         String? @db.VarChar(36)
  ownerUserId       String? @db.VarChar(36)

  customerAccount      CustomerAccount?      @relation(fields: [customerAccountId], references: [id], onDelete: Restrict)
  contact              Contact?              @relation("LeadContact", fields: [contactId], references: [id], onDelete: SetNull)
  owner                User?                 @relation("LeadOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  opportunities        Opportunity[]
  activityContexts     ActivityContext[]     @relation("ActivityContextLead")
  documentRelations    DocumentRelation[]    @relation("DocumentRelationLead")
  notificationContexts NotificationContext[] @relation("NotificationContextLead")
  quotes               Quote[]               @relation("QuoteLead")

  createdAt DateTime @default(now()) @db.DateTime(3)

  @@index([customerAccountId])
  @@index([contactId])
  @@index([ownerUserId])
}

model Opportunity {
  id                String   @id @default(uuid()) @db.VarChar(36)
  title             String   @db.VarChar(191)
  status            String   @db.VarChar(50)
  leadId            String?  @db.VarChar(36)
  customerAccountId String?  @db.VarChar(36)
  contactId         String?  @db.VarChar(36)
  ownerUserId       String?  @db.VarChar(36)
  estimatedValue    Decimal?
  currency          String?  @db.VarChar(3)

  lead                 Lead?                 @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customerAccount      CustomerAccount?      @relation(fields: [customerAccountId], references: [id], onDelete: Restrict)
  contact              Contact?              @relation("OpportunityContact", fields: [contactId], references: [id], onDelete: SetNull)
  owner                User?                 @relation("OpportunityOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  quotes               Quote[]
  activityContexts     ActivityContext[]     @relation("ActivityContextOpportunity")
  documentRelations    DocumentRelation[]    @relation("DocumentRelationOpportunity")
  notificationContexts NotificationContext[] @relation("NotificationContextOpportunity")

  createdAt DateTime @default(now()) @db.DateTime(3)

  @@index([leadId])
  @@index([customerAccountId])
  @@index([contactId])
  @@index([ownerUserId])
}

model Activity {
  id             String    @id @default(uuid()) @db.VarChar(36)
  subject        String    @db.VarChar(191)
  activityType   String    @db.VarChar(100)
  status         String    @db.VarChar(50)
  dueAt          DateTime? @db.DateTime(3)
  assignedUserId String?   @db.VarChar(36)
  notes          String?   @db.Text

  assignedUser         User?                 @relation("ActivityAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  contexts             ActivityContext[]
  notificationContexts NotificationContext[] @relation("NotificationContextActivity")

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  @@index([assignedUserId])
  @@index([dueAt])
}

model ActivityContext {
  id                String  @id @default(uuid()) @db.VarChar(36)
  activityId        String  @db.VarChar(36)
  leadId            String? @db.VarChar(36)
  opportunityId     String? @db.VarChar(36)
  customerAccountId String? @db.VarChar(36)
  contactId         String? @db.VarChar(36)
  quoteId           String? @db.VarChar(36)
  orderId           String? @db.VarChar(36)
  ticketId          String? @db.VarChar(36)

  activity        Activity         @relation(fields: [activityId], references: [id], onDelete: Restrict)
  lead            Lead?            @relation("ActivityContextLead", fields: [leadId], references: [id], onDelete: Restrict)
  opportunity     Opportunity?     @relation("ActivityContextOpportunity", fields: [opportunityId], references: [id], onDelete: Restrict)
  customerAccount CustomerAccount? @relation("ActivityContextCustomerAccount", fields: [customerAccountId], references: [id], onDelete: Restrict)
  contact         Contact?         @relation("ActivityContextContact", fields: [contactId], references: [id], onDelete: Restrict)
  quote           Quote?           @relation("ActivityContextQuote", fields: [quoteId], references: [id], onDelete: Restrict)
  order           Order?           @relation("ActivityContextOrder", fields: [orderId], references: [id], onDelete: Restrict)
  ticket          Ticket?          @relation("ActivityContextTicket", fields: [ticketId], references: [id], onDelete: Restrict)

  @@unique([activityId, leadId])
  @@unique([activityId, opportunityId])
  @@unique([activityId, customerAccountId])
  @@unique([activityId, contactId])
  @@unique([activityId, quoteId])
  @@unique([activityId, orderId])
  @@unique([activityId, ticketId])
  @@index([activityId])
  @@index([leadId])
  @@index([opportunityId])
  @@index([customerAccountId])
  @@index([contactId])
  @@index([quoteId])
  @@index([orderId])
  @@index([ticketId])
}

model Product {
  id                   String                @id @default(uuid()) @db.VarChar(36)
  code                 String                @unique @db.VarChar(100)
  name                 String                @db.VarChar(191)
  category             String?               @db.VarChar(100)
  status               String                @db.VarChar(50)
  provisioningCategory ProvisioningCategory?

  commercialProfileVersions ProductCommercialProfileVersion[]
  supplierAssignments       SupplierAssignment[]
  quoteItems                QuoteItem[]
  orderItems                OrderItem[]
  services                  Service[]
  invoiceLines              InvoiceLine[]
  ticketContexts            TicketContext[]                   @relation("TicketContextProduct")

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
}

model ProductCommercialProfileVersion {
  id                        String    @id @default(uuid()) @db.VarChar(36)
  productId                 String    @db.VarChar(36)
  effectiveFrom             DateTime  @db.DateTime(3)
  effectiveTo               DateTime? @db.DateTime(3)
  taxConfigurationReference String?   @db.VarChar(191)

  product      Product                   @relation(fields: [productId], references: [id], onDelete: Restrict)
  priceOptions ProductPriceOption[]
  termVersions SubscriptionTermVersion[]

  createdAt DateTime @default(now()) @db.DateTime(3)

  @@index([productId, effectiveFrom])
}

model ProductPriceOption {
  id                         String   @id @default(uuid()) @db.VarChar(36)
  commercialProfileVersionId String   @db.VarChar(36)
  amount                     Decimal
  setupFee                   Decimal?
  currency                   String   @db.VarChar(3)
  billingCycle               String?  @db.VarChar(50)
  quantityModel              String?  @db.VarChar(100)

  commercialProfileVersion ProductCommercialProfileVersion @relation(fields: [commercialProfileVersionId], references: [id], onDelete: Restrict)

  @@index([commercialProfileVersionId])
}

model Vendor {
  id   String @id @default(uuid()) @db.VarChar(36)
  name String @db.VarChar(191)

  contacts             VendorContact[]
  offerings            SupplierOffering[]
  purchaseOrders       PurchaseOrder[]
  invoices             VendorInvoice[]
  documentRelations    DocumentRelation[]    @relation("DocumentRelationVendor")
  notificationContexts NotificationContext[] @relation("NotificationContextVendor")

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
}

model VendorContact {
  id       String  @id @default(uuid()) @db.VarChar(36)
  vendorId String  @db.VarChar(36)
  name     String  @db.VarChar(191)
  email    String? @db.VarChar(191)

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@index([vendorId])
}

model SupplierOffering {
  id                String  @id @default(uuid()) @db.VarChar(36)
  vendorId          String  @db.VarChar(36)
  name              String  @db.VarChar(191)
  externalReference String? @db.VarChar(191)

  vendor             Vendor                @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  assignments        SupplierAssignment[]
  costHistory        SupplierCostHistory[]
  purchaseOrderItems PurchaseOrderItem[]

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  @@index([vendorId])
}

model SupplierAssignment {
  id                 String    @id @default(uuid()) @db.VarChar(36)
  productId          String    @db.VarChar(36)
  supplierOfferingId String    @db.VarChar(36)
  effectiveFrom      DateTime? @db.DateTime(3)
  effectiveTo        DateTime? @db.DateTime(3)

  product                Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  supplierOffering       SupplierOffering        @relation(fields: [supplierOfferingId], references: [id], onDelete: Restrict)
  services               Service[]
  provisioningOperations ProvisioningOperation[]

  createdAt DateTime @default(now()) @db.DateTime(3)

  @@index([productId, effectiveFrom])
  @@index([supplierOfferingId])
}

model SupplierCostHistory {
  id                 String    @id @default(uuid()) @db.VarChar(36)
  supplierOfferingId String    @db.VarChar(36)
  cost               Decimal
  currency           String    @db.VarChar(3)
  effectiveFrom      DateTime  @db.DateTime(3)
  effectiveTo        DateTime? @db.DateTime(3)

  supplierOffering SupplierOffering @relation(fields: [supplierOfferingId], references: [id], onDelete: Restrict)

  @@index([supplierOfferingId, effectiveFrom])
}

model Quote {
  id                String    @id @default(uuid()) @db.VarChar(36)
  customerAccountId String    @db.VarChar(36)
  contactId         String?   @db.VarChar(36)
  leadId            String?   @db.VarChar(36)
  opportunityId     String?   @db.VarChar(36)
  status            String    @db.VarChar(50)
  issuedAt          DateTime? @db.DateTime(3)
  expiresAt         DateTime? @db.DateTime(3)

  customerAccount      CustomerAccount       @relation(fields: [customerAccountId], references: [id], onDelete: Restrict)
  contact              Contact?              @relation("QuoteContact", fields: [contactId], references: [id], onDelete: Restrict)
  lead                 Lead?                 @relation("QuoteLead", fields: [leadId], references: [id], onDelete: Restrict)
  opportunity          Opportunity?          @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  items                QuoteItem[]
  orders               Order[]
  activityContexts     ActivityContext[]     @relation("ActivityContextQuote")
  documentRelations    DocumentRelation[]    @relation("DocumentRelationQuote")
  notificationContexts NotificationContext[] @relation("NotificationContextQuote")

  createdAt DateTime @default(now()) @db.DateTime(3)

  @@index([customerAccountId])
  @@index([contactId])
  @@index([leadId])
  @@index([opportunityId])
}

model QuoteItem {
  id              String   @id @default(uuid()) @db.VarChar(36)
  quoteId         String   @db.VarChar(36)
  productId       String   @db.VarChar(36)
  productCode     String   @db.VarChar(100)
  productName     String   @db.VarChar(191)
  description     String?  @db.Text
  quantity        Decimal
  unitPrice       Decimal
  currency        String   @db.VarChar(3)
  setupAmount     Decimal?
  recurringAmount Decimal?
  billingCycle    String?  @db.VarChar(50)
  discountAmount  Decimal?
  taxBasis        String?  @db.VarChar(100)
  taxRate         Decimal?
  taxAmount       Decimal?
  lineTotal       Decimal

  quote      Quote       @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  @@index([quoteId])
  @@index([productId])
}

model Order {
  id                String    @id @default(uuid()) @db.VarChar(36)
  customerAccountId String    @db.VarChar(36)
  quoteId           String?   @db.VarChar(36)
  status            String    @db.VarChar(50)
  placedAt          DateTime? @db.DateTime(3)

  customerAccount      CustomerAccount       @relation(fields: [customerAccountId], references: [id], onDelete: Restrict)
  quote                Quote?                @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  items                OrderItem[]
  activityContexts     ActivityContext[]     @relation("ActivityContextOrder")
  ticketContexts       TicketContext[]       @relation("TicketContextOrder")
  purchaseOrders       PurchaseOrder[]
  documentRelations    DocumentRelation[]    @relation("DocumentRelationOrder")
  notificationContexts NotificationContext[] @relation("NotificationContextOrder")

  createdAt DateTime @default(now()) @db.DateTime(3)

  @@index([customerAccountId])
  @@index([quoteId])
}

model OrderItem {
  id              String   @id @default(uuid()) @db.VarChar(36)
  orderId         String   @db.VarChar(36)
  productId       String   @db.VarChar(36)
  quoteItemId     String?  @db.VarChar(36)
  productCode     String   @db.VarChar(100)
  productName     String   @db.VarChar(191)
  description     String?  @db.Text
  quantity        Decimal
  unitPrice       Decimal
  currency        String   @db.VarChar(3)
  setupAmount     Decimal?
  recurringAmount Decimal?
  billingCycle    String?  @db.VarChar(50)
  discountAmount  Decimal?
  taxBasis        String?  @db.VarChar(100)
  taxRate         Decimal?
  taxAmount       Decimal?
  lineTotal       Decimal

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product      Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  quoteItem    QuoteItem?    @relation(fields: [quoteItemId], references: [id], onDelete: Restrict)
  services     Service[]
  invoiceLines InvoiceLine[]

  @@index([orderId])
  @@index([productId])
  @@index([quoteItemId])
}

model Service {
  id                   String  @id @default(uuid()) @db.VarChar(36)
  customerAccountId    String  @db.VarChar(36)
  productId            String  @db.VarChar(36)
  orderItemId          String? @db.VarChar(36)
  supplierAssignmentId String? @db.VarChar(36)
  productCodeSnapshot  String  @db.VarChar(100)
  productNameSnapshot  String  @db.VarChar(191)
  status               String  @db.VarChar(50)

  customerAccount        CustomerAccount         @relation(fields: [customerAccountId], references: [id], onDelete: Restrict)
  product                Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItem              OrderItem?              @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  supplierAssignment     SupplierAssignment?     @relation(fields: [supplierAssignmentId], references: [id], onDelete: Restrict)
  subscriptions          Subscription[]
  provisioningOperations ProvisioningOperation[]
  invoiceLines           InvoiceLine[]
  purchaseOrders         PurchaseOrder[]
  ticketContexts         TicketContext[]         @relation("TicketContextService")
  documentRelations      DocumentRelation[]      @relation("DocumentRelationService")
  notificationContexts   NotificationContext[]   @relation("NotificationContextService")

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  @@index([customerAccountId])
  @@index([productId])
  @@index([orderItemId])
  @@index([supplierAssignmentId])
}

model Subscription {
  id        String    @id @default(uuid()) @db.VarChar(36)
  serviceId String    @db.VarChar(36)
  status    String    @db.VarChar(50)
  startedAt DateTime? @db.DateTime(3)
  endedAt   DateTime? @db.DateTime(3)

  service              Service                   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  termVersions         SubscriptionTermVersion[]
  invoiceLines         InvoiceLine[]
  ticketContexts       TicketContext[]           @relation("TicketContextSubscription")
  documentRelations    DocumentRelation[]        @relation("DocumentRelationSubscription")
  notificationContexts NotificationContext[]     @relation("NotificationContextSubscription")

  createdAt DateTime @default(now()) @db.DateTime(3)

  @@index([serviceId])
}

model SubscriptionTermVersion {
  id                                String    @id @default(uuid()) @db.VarChar(36)
  subscriptionId                    String    @db.VarChar(36)
  productCommercialProfileVersionId String?   @db.VarChar(36)
  effectiveFrom                     DateTime  @db.DateTime(3)
  effectiveTo                       DateTime? @db.DateTime(3)
  quantity                          Decimal
  recurringPrice                    Decimal
  currency                          String    @db.VarChar(3)
  billingCycle                      String    @db.VarChar(50)

  subscription             Subscription                     @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  commercialProfileVersion ProductCommercialProfileVersion? @relation(fields: [productCommercialProfileVersionId], references: [id], onDelete: Restrict)

  @@index([subscriptionId, effectiveFrom])
  @@index([productCommercialProfileVersionId])
}

model ProvisioningOperation {
  id                   String    @id @default(uuid()) @db.VarChar(36)
  serviceId            String    @db.VarChar(36)
  supplierAssignmentId String?   @db.VarChar(36)
  operationKind        String    @db.VarChar(100)
  outcome              String?   @db.VarChar(100)
  externalReference    String?   @db.VarChar(191)
  requestedAt          DateTime  @default(now()) @db.DateTime(3)
  completedAt          DateTime? @db.DateTime(3)

  service              Service               @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  supplierAssignment   SupplierAssignment?   @relation(fields: [supplierAssignmentId], references: [id], onDelete: Restrict)
  notificationContexts NotificationContext[] @relation("NotificationContextProvisioningOperation")

  @@index([serviceId, requestedAt])
  @@index([supplierAssignmentId])
}

model Invoice {
  id                String    @id @default(uuid()) @db.VarChar(36)
  customerAccountId String    @db.VarChar(36)
  billingContactId  String?   @db.VarChar(36)
  status            String    @db.VarChar(50)
  currency          String    @db.VarChar(3)
  issueDate         DateTime? @db.DateTime(3)
  dueDate           DateTime? @db.DateTime(3)
  subtotal          Decimal?
  taxTotal          Decimal?
  total             Decimal?

  customerAccount      CustomerAccount       @relation(fields: [customerAccountId], references: [id], onDelete: Restrict)
  billingContact       Contact?              @relation("InvoiceBillingContact", fields: [billingContactId], references: [id], onDelete: Restrict)
  lines                InvoiceLine[]
  paymentAllocations   PaymentAllocation[]
  creditApplications   CreditApplication[]
  creditNotes          CreditNote[]
  refunds              Refund[]
  ticketContexts       TicketContext[]       @relation("TicketContextInvoice")
  documentRelations    DocumentRelation[]    @relation("DocumentRelationInvoice")
  notificationContexts NotificationContext[] @relation("NotificationContextInvoice")

  createdAt DateTime @default(now()) @db.DateTime(3)

  @@index([customerAccountId])
  @@index([billingContactId])
}

model InvoiceLine {
  id             String   @id @default(uuid()) @db.VarChar(36)
  invoiceId      String   @db.VarChar(36)
  productId      String?  @db.VarChar(36)
  serviceId      String?  @db.VarChar(36)
  subscriptionId String?  @db.VarChar(36)
  orderItemId    String?  @db.VarChar(36)
  description    String   @db.Text
  quantity       Decimal
  unitPrice      Decimal
  currency       String   @db.VarChar(3)
  discountAmount Decimal?
  taxBasis       String?  @db.VarChar(100)
  taxRate        Decimal?
  taxAmount      Decimal?
  lineTotal      Decimal

  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  product      Product?      @relation(fields: [productId], references: [id], onDelete: Restrict)
  service      Service?      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  orderItem    OrderItem?    @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([productId])
  @@index([serviceId])
  @@index([subscriptionId])
  @@index([orderItemId])
}

model Payment {
  id                String    @id @default(uuid()) @db.VarChar(36)
  customerAccountId String    @db.VarChar(36)
  status            String    @db.VarChar(50)
  amount            Decimal
  currency          String    @db.VarChar(3)
  paymentMethod     String?   @db.VarChar(100)
  paymentReference  String?   @db.VarChar(191)
  receivedAt        DateTime? @db.DateTime(3)

  customerAccount      CustomerAccount       @relation(fields: [customerAccountId], references: [id], onDelete: Restrict)
  allocations          PaymentAllocation[]
  refunds              Refund[]
  ticketContexts       TicketContext[]       @relation("TicketContextPayment")
  documentRelations    DocumentRelation[]    @relation("DocumentRelationPayment")
  notificationContexts NotificationContext[] @relation("NotificationContextPayment")

  createdAt DateTime @default(now()) @db.DateTime(3)

  @@index([customerAccountId])
  @@index([receivedAt])
}

model PaymentAllocation {
  id          String   @id @default(uuid()) @db.VarChar(36)
  paymentId   String   @db.VarChar(36)
